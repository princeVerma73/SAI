# -------------------------------------------------------------
# Environment & Secrets (Never commit secrets)
# -------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# -------------------------------------------------------------
# Node.js, Vite & Frontend/Backend Dependencies & Builds
# -------------------------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
dist/
*/dist/
build/
*/build/
.vite/
*/.vite/
**/dist-ssr/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# -------------------------------------------------------------
# Python, Pytest & Virtual Environments
# -------------------------------------------------------------
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
develop-eggs/
downloads/
eggs/
.eggs/
# Scoped Python virtual environment libraries (prevents shadowing app source libs)
/lib/
/lib64/
!client/src/lib/
!client/src/**/lib/
!server/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# -------------------------------------------------------------
# Prisma & Local Databases
# -------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal

# -------------------------------------------------------------
# Operating System & IDE Files
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# -------------------------------------------------------------
# Logs, Temporary Files & Uploads
# -------------------------------------------------------------
logs/
*.log
tmp/
temp/
uploads/
*/uploads/
